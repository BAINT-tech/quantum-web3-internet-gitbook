{
  "title": "QUANTUM•WEB3•INTERNET",
  "description": "Exploring the convergence of quantum computing, blockchain technology, and decentralized networks",
  "author": "Quantum Web3 Team",
  "language": "en",
  "gitbook": "3.2.3",
  "plugins": [
    "theme-default",
    "search",
    "sharing",
    "fontsettings",
    "livereload"
  ],
  "pluginsConfig": {
    "theme-default": {
      "showLevel": true,
      "logo": "banner.png"
